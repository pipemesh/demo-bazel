common --java_language_version=21 --java_runtime_version=remotejdk_21
common --tool_java_language_version=21 --tool_java_runtime_version=remotejdk_21
test --test_output=errors
# Nothing here compiles C or C++: don't look for a compiler (the hosted
# runner image has none, and java_binary's launcher would otherwise ask).
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
